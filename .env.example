# ==========================================
# FewFeww MVP Environment Variables
# ==========================================

# Server
PORT=8080
NODE_ENV=development
APP_BASE_URL=http://localhost:8080

# Database (PostgreSQL 17)
DATABASE_URL=postgresql://fewfeww:devpassword@localhost:5432/fewfeww

# Telegram Bot Credentials (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=FewFewwDevBot
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret_token_at_least_32_chars
TELEGRAM_WEBHOOK_PATH=tg-webhook-secret-path

# LLM Configuration (Groq for fast tool-calling)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_REMINDER_TIME=09:00
DEFAULT_LEAD_MINUTES=60
QUIET_START=22:00
QUIET_END=07:00

# Admin / Diagnostics
ADMIN_CHAT_ID=
